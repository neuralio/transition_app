    tool = MLUTool()
    test = MLUQueryInput(query="Run simulation for wheat under RCP 4.5", scenario="rcp45", crop="WHEAT")
    result = tool.run(test)
    print(f"User Story: {result.user_story}")
    print(f"Status: {result.status}")

